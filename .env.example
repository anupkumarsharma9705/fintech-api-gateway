# Copy this file to .env and replace every value before exposing the stack.
# .env is git-ignored; .env.example must never contain real secrets.

# ── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=replace-me-root
MYSQL_DB=FintechGateway
MYSQL_USER=fintech
MYSQL_PASSWORD=replace-me-app
MYSQL_PUBLISHED_PORT=3307

# ── Redis ───────────────────────────────────────────────────────────────────
# Leave empty for local development. Use a strong password in any shared or
# production environment; the gateway supports REDIS_PASSWORD.
REDIS_PASSWORD=
REDIS_PUBLISHED_PORT=6379

# ── Gateway ─────────────────────────────────────────────────────────────────
# dev enables Swagger UI. Use prod for anything internet-facing.
SPRING_PROFILES_ACTIVE=dev
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8081

# Required by the operator endpoints under /feedback and /compliance. Generate a long random
# value (for example: openssl rand -hex 32) and keep it out of source control.
INTERNAL_OPS_API_KEY=dev-ops-key-change-me

# OAuth2 client authentication. Required in production; dev profile defaults to disabled.
# Configure at least one of OAUTH2_ISSUER_URI or OAUTH2_JWK_SET_URI.
# GATEWAY_AUTH_ENABLED=false
# OAUTH2_ISSUER_URI=https://auth.example.com
# OAUTH2_JWK_SET_URI=https://auth.example.com/.well-known/jwks.json
# OAUTH2_AUDIENCE=fintech-gateway
# OAUTH2_REQUIRED_SCOPES=gateway.api
# OAUTH2_CLOCK_SKEW=60s

# Only enable when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Admission policy. gcra is the default; sorted-set is the exact reference path.
# The abuse ceiling is per tenant + IP; raise it for capacity tests.
RATE_LIMIT_ALGORITHM=gcra
RATE_ABUSE_LIMIT_PER_IP=6000

# Durable audit persistence. 1.0 writes every event. Below 1.0 samples only
# clean ALLOW traffic; prod refuses a rate below 0.01. Security, payment and
# idempotency events are always written. Compliance responses disclose the rate.
AUDIT_SAMPLE_RATE=1.0
